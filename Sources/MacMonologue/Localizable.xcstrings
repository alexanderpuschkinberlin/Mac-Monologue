        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte %@ und drück dann %@"
          }
        }
      }
    },
    "How sharp should your videos be?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie scharf sollen deine Videos sein?"
          }
        }
      }
    },
    "How sharp the video is, and how big the file gets.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie scharf das Video ist und wie groß die Datei wird."
          }
        }
      }
    },
    "In my videos I speak": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In meinen Videos spreche ich"
          }
        }
      }
    },
