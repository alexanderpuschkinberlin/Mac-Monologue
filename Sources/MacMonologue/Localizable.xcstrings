      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dich beim Reden auf – oder deinen Bildschirm mit dir in einem kleinen Kreis in der Ecke, wie bei Tutorials auf YouTube. Eine Taste startet, dieselbe Taste pausiert, und dein Video ist fertig. Ohne Nachbearbeitung."
          }
        }
      }
    },
