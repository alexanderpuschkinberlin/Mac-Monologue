#!/usr/bin/env bash
# Run the unit tests (no camera or microphone required). Always in English, so
# a test that reads a label passes whatever language the Mac is set to.
set -euo pipefail
cd "$(dirname "$0")/.."
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
xcodegen generate --quiet
xcodebuild \
  -project Mac-Monologue.xcodeproj \
  -scheme Mac-Monologue \
  -configuration Debug \
  -derivedDataPath build \
  -testLanguage en -testRegion US \
  test | tail -n 30
