#!/usr/bin/env bash
# Generate the Xcode project and build the app.
#   bin/build            → Debug
#   bin/build Release    → Release
set -euo pipefail
cd "$(dirname "$0")/.."

CONFIG="${1:-Debug}"

# Command Line Tools are the active toolchain on this machine; xcodebuild needs Xcode.
# Setting DEVELOPER_DIR avoids having to `sudo xcode-select -s`.
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"

command -v xcodegen >/dev/null || { echo "xcodegen missing: brew install xcodegen" >&2; exit 1; }

if [ ! -f Resources/AppIcon.icns ]; then
  echo "Generating app icon..."
  swift tools/make-icon.swift >/dev/null
  mkdir -p Resources
  iconutil -c icns build/AppIcon.iconset -o Resources/AppIcon.icns
fi

xcodegen generate --quiet
xcodebuild \
  -project Mac-Monologue.xcodeproj \
  -scheme Mac-Monologue \
  -configuration "$CONFIG" \
  -derivedDataPath build \
  build | tail -n 20

APP="build/Build/Products/$CONFIG/Mac-Monologue.app"

# Re-sign with the stable identity when it exists. The Xcode setting stays
# ad-hoc so a fresh clone builds on any machine, but ad-hoc means a new code
# signature on every build, and macOS re-asks for camera and microphone access
# each time. bin/make-signing-cert creates the identity.
IDENTITY="${SIGNING_IDENTITY:-Mac-Monologue Self-Signed}"
if security find-identity -p codesigning 2>/dev/null | grep -q "$IDENTITY"; then
  codesign --force --sign "$IDENTITY" --timestamp=none "$APP" >/dev/null 2>&1 || true
fi

echo "→ $APP"
