          }
        }
      }
    },
    "Sizes are for ten minutes of recording, picture and sound together. A still slide takes less, a lot of movement a little more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Größen gelten für zehn Minuten Aufnahme, Bild und Ton zusammen. Eine ruhige Folie braucht weniger, viel Bewegung etwas mehr."
          }
        }
      }
    },
    "Skip This Version": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version überspringen"
          }
        }
      }
    },
