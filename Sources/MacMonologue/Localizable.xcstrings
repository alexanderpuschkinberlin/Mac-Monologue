        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme beenden"
          }
        }
      }
    },
    "Finishing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beendet"
          }
        }
      }
    },
    "Finishing…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beendet …"
          }
        }
      }
    },
    "Fixed while recording. The sound fader stays live.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Aufnahme fest. Der Ton-Regler bleibt bedienbar."
          }
        }
      }
    },
    "Follows your face by zooming in a little and moving with you. The picture gets slightly softer, since part of it is cropped away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt deinem Gesicht, indem es leicht hineinzoomt und mitwandert. Das Bild wird etwas weicher, weil ein Teil abgeschnitten wird."
          }
        }
      }
    },
    "From any app — while presenting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus jeder App – auch beim Präsentieren"
          }
        }
      }
    },
    "Getting the %@ translation. macOS may ask you to confirm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung für %@ wird geholt. macOS fragt eventuell nach."
          }
        }
      }
    },
    "Green Screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigestellt"
          }
        }
      }
