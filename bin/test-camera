#!/usr/bin/env bash
# Opt-in smoke test against the real camera and microphone.
#
# Records 2s, pauses 3s, records 2s, finishes. A correct take is ~4s long:
# if the pause arithmetic is wrong it comes out ~7s, with the dead air in it.
set -euo pipefail
cd "$(dirname "$0")/.."

./bin/build Debug >/dev/null

osascript -e 'quit app "Mac-Monologue"' 2>/dev/null || true
pkill -f "Mac-Monologue.app/Contents/MacOS/Mac-Monologue" 2>/dev/null || true
sleep 1

APP="build/Build/Products/Debug/Mac-Monologue.app/Contents/MacOS/Mac-Monologue"
"$APP" --self-test
