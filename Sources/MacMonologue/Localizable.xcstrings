        }
      }
    },
    "Choose a mode at the top of the window, press Record, and talk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle oben im Fenster einen Modus, drück auf Aufnehmen und leg los."
