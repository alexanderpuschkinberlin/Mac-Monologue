#!/usr/bin/env bash
# Creates a self-signed code-signing certificate in your login keychain.
#
# Why not ad-hoc signing: macOS ties camera and microphone permission to the
# app's code signature. An ad-hoc signed app gets a new identity on every
# rebuild, so you re-grant access every time. A stable certificate fixes that.
#
# This is not notarization — recipients still use Open Anyway once. The
# certificate is deliberately NOT added to the trust store: signing does not
# need it, and doing so would mean a GUI password prompt or sudo.
#
# Run it once.
set -euo pipefail

NAME="${1:-Mac-Monologue Self-Signed}"
KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"

if security find-certificate -c "$NAME" >/dev/null 2>&1; then
  echo "'$NAME' already exists in the login keychain."
  exit 0
fi

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# A throwaway password, not an empty one: OpenSSL 3 writes an empty-password
# PKCS#12 whose MAC macOS refuses with "MAC verification failed".
PASSWORD="$(openssl rand -hex 16)"

openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
  -keyout "$WORK/key.pem" -out "$WORK/cert.pem" \
  -subj "/CN=$NAME/O=$NAME" \
  -addext "basicConstraints=critical,CA:false" \
  -addext "keyUsage=critical,digitalSignature" \
  -addext "extendedKeyUsage=critical,codeSigning" 2>/dev/null

# -legacy: macOS cannot read OpenSSL 3's default AES-256-CBC/PBKDF2 container.
openssl pkcs12 -export -legacy -macalg sha1 \
  -inkey "$WORK/key.pem" -in "$WORK/cert.pem" \
  -name "$NAME" -out "$WORK/identity.p12" -passout "pass:$PASSWORD"

security import "$WORK/identity.p12" -k "$KEYCHAIN" -P "$PASSWORD" \
  -T /usr/bin/codesign -T /usr/bin/security

# Without this, codesign stops to ask permission on every single build.
security set-key-partition-list -S apple-tool:,apple: -k "" "$KEYCHAIN" >/dev/null 2>&1 || true

echo "Created '$NAME'."
security find-identity -p codesigning | grep "$NAME" || true
