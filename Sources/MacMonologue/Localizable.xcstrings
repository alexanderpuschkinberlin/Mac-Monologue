            "state": "translated",
            "value": "Ziehen"
          }
        }
      }
    },
    "Drag yourself anywhere in the preview.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh dich in der Vorschau an jede Stelle."
          }
        }
      }
    },
    "During the countdown, the finger decides how the take opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Countdowns entscheidet der Finger, womit die Aufnahme beginnt."
          }
        }
      }
    },
    "Economical": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparsam"
          }
        }
      }
    },
    "Esc cancels": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc bricht ab"
          }
        }
      }
    },
    "Finger lifted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finger losgelassen"
          }
        }
      }
    },
    "Finger on the trackpad": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finger auf dem Trackpad"
          }
        }
      }
    },
    "Finger on the trackpad → your screen, you in the bubble": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finger auf dem Trackpad → dein Bildschirm, du in der Blase"
          }
        }
      }
    },
    "Finish": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        }
