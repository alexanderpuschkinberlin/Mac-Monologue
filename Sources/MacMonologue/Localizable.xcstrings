      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet in %lld"
          }
        }
      }
    },
    "Starting in %lld…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet in %lld …"
          }
        }
      }
    },
    "Starts on the screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt mit dem Bildschirm"
          }
        }
      }
